# ======================================================================
# Local dev only — shared Supabase stack secrets & settings.
# NOT production secrets. Never reuse these values in a hosted project.
# ======================================================================

# --- Postgres ---------------------------------------------------------
# One password for postgres + the internal service roles (see volumes/db/roles.sql)
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# --- JWT / API keys ---------------------------------------------------
# Legacy symmetric HS256 model (same as `supabase start` local stacks).
# Keys below are signed with JWT_SECRET — regenerate as a pair if you change it:
#   node -e "<HS256 JWT with payload {iss:'supabase',ref:'donate-local',role:'anon'|'service_role',iat,exp}>"
JWT_SECRET=donate-local-jwt-secret-0123456789abcdef0123456789abcdef
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvbmF0ZS1sb2NhbCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzM1Njg5NjAwLCJleHAiOjIwMDAwMDAwMDB9.rxYJXZjq9-79AwTwyTrV-doFGcjbJuUnpsM_84UKdOE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvbmF0ZS1sb2NhbCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3MzU2ODk2MDAsImV4cCI6MjAwMDAwMDAwMH0.6O_5TootXKOufHOxIjx21yHB1bKYojogwLlp7xS96FI

# --- URLs -------------------------------------------------------------
# Client app (auth redirect target)
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:3000/**,http://localhost:3000/**
# Externally visible API URL (email links, issuer claim) — the Kong port
API_EXTERNAL_URL=http://localhost:55321/auth/v1
SUPABASE_PUBLIC_URL=http://localhost:55321

# Host ports (repo convention = supabase/config.toml offset profile)
DOCKER_API_PORT=55321
DOCKER_DB_PORT=55322
DOCKER_STUDIO_PORT=55323
DOCKER_INBUCKET_PORT=55324

# --- Auth behaviour ---------------------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Local dev: signup/login never blocks on email confirmation (parity with
# supabase/config.toml [auth.email] enable_confirmations = false)
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
SMTP_ADMIN_EMAIL=admin@email.com
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=inbucket-user
SMTP_PASS=inbucket-pass
SMTP_SENDER_NAME=Admin

# --- PostgREST / Studio ----------------------------------------------
# API surface = the donate product schema. Future products add their
# schema here (schema must exist) and run: docker compose up -d rest studio
# The `shared` data layer is intentionally NOT exposed — products reach it
# only through SECURITY DEFINER functions in their own schema.
PGRST_DB_SCHEMAS=donate
PGRST_DB_MAX_ROWS=100000
PGRST_DB_EXTRA_SEARCH_PATH=donate,shared,extensions
STUDIO_DEFAULT_ORGANIZATION=Donate Platform
STUDIO_DEFAULT_PROJECT=Shared Supabase
OPENAI_API_KEY=
PG_META_CRYPTO_KEY=donate-local-pgmeta-crypto-key-0123456789abcdef

# --- Storage (file backend) -------------------------------------------
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
